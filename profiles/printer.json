{
  "profile_id": "printer",
  "name": "Network printer (Printer-MIB: HP, Brother, Canon, Epson and others)",
  "vendor": "Various",
  "category": "printer",
  "match_priority": 12,
  "notes": "Written from the vendor's published MIB; not yet confirmed on real hardware.",
  "signature_oids": [
    {
      "oid": "1.3.6.1.2.1.43.5.1.1.16.1",
      "match_exists": true
    },
    {
      "oid": "1.3.6.1.2.1.43.11.1.1.6.1.1",
      "match_exists": true
    }
  ],
  "tables": [
    "interfaces"
  ],
  "inventory_oids": {
    "model": "1.3.6.1.2.1.25.3.2.1.3.1"
  },
  "metrics": [
    {
      "key": "uptime_seconds",
      "oid": "1.3.6.1.2.1.1.3.0",
      "type": "timeticks",
      "unit": "seconds",
      "history": "none"
    },
    {
      "key": "printer_pages",
      "oid": "1.3.6.1.2.1.43.10.2.1.4.1.1",
      "type": "integer",
      "label": "Pages printed",
      "unit": "count",
      "group": "Printing",
      "kpi": true
    },
    {
      "key": "printer_state",
      "oid": "1.3.6.1.2.1.25.3.5.1.1.1",
      "type": "integer",
      "label": "Printer state",
      "group": "Printing",
      "values": {
        "1": "Other",
        "2": "Unknown",
        "3": "Idle",
        "4": "Printing",
        "5": "Warming up"
      },
      "history": "change",
      "event": true
    },
    {
      "key": "printer_device_status",
      "oid": "1.3.6.1.2.1.25.3.2.1.5.1",
      "type": "integer",
      "label": "Device status",
      "group": "Printing",
      "values": {
        "1": "Unknown",
        "2": "Running",
        "3": "Warning",
        "4": "Testing",
        "5": "Down"
      },
      "history": "change",
      "event": true
    }
  ],
  "alerts": [
    {
      "key": "printer_device_status",
      "in": [
        5
      ],
      "severity": "warning",
      "message": "Printer is down"
    },
    {
      "key": "printer_device_status",
      "in": [
        3
      ],
      "severity": "info",
      "message": "Printer reports a warning (paper, toner or a cover)"
    }
  ],
  "table_defs": [
    {
      "table": "health",
      "walk": "1.3.6.1.2.1.43.11.1.1",
      "columns": {
        "name": 6,
        "max": {
          "col": 8,
          "type": "number"
        },
        "level": {
          "col": 9,
          "type": "number"
        }
      },
      "fixed": {
        "kind": "supply"
      },
      "pct": [
        "level",
        "max"
      ],
      "ok": {
        "field": "pct",
        "min": 10
      },
      "severity": "warning",
      "metrics": [
        {
          "field": "pct",
          "key": "supply.{index}.pct"
        }
      ]
    }
  ]
}
