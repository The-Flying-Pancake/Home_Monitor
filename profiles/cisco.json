{
  "profile_id": "cisco",
  "name": "Cisco switch / router (IOS, IOS-XE, SMB)",
  "vendor": "Cisco",
  "category": "switch",
  "match_priority": 20,
  "notes": "Written from the vendor's published MIB; not yet confirmed on real hardware.",
  "signature_oids": [
    {
      "oid": "1.3.6.1.2.1.1.2.0",
      "match_prefix": "1.3.6.1.4.1.9"
    },
    {
      "oid": "1.3.6.1.2.1.1.1.0",
      "match_contains": "cisco ios"
