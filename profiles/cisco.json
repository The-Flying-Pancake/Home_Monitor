      "label": "CPU usage (5 min)",
      "unit": "percent"
    },
    {
      "key": "mem_used_bytes",
      "walk": "1.3.6.1.4.1.9.9.48.1.1.1.5",
      "aggregate": "first",
      "type": "integer",
      "history": "none",
      "label": "Memory used",
      "unit": "bytes"
    },
    {
      "key": "mem_free_bytes",
      "walk": "1.3.6.1.4.1.9.9.48.1.1.1.6",
