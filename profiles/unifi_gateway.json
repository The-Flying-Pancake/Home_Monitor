      "unit": "seconds",
      "history": "none"
    },
    {
      "key": "cpu_load_1m",
      "oid": "1.3.6.1.4.1.2021.10.1.3.1",
      "type": "string_float",
      "unit": "load",
      "history": "none"
    },
    {
      "key": "cpu_load_5m",
      "oid": "1.3.6.1.4.1.2021.10.1.3.2",
      "type": "string_float",
      "unit": "load",
      "history": "none"
    },
    {
      "key": "cpu_idle_pct",
      "oid": "1.3.6.1.4.1.2021.11.11.0",
      "type": "integer",
      "unit": "percent",
      "history": "none"
    },
    {
      "key": "mem_total_kb",
      "oid": "1.3.6.1.4.1.2021.4.5.0",
      "type": "gauge_kb",
      "unit": "KB",
      "history": "change"
    },
    {
      "key": "mem_avail_kb",
      "oid": "1.3.6.1.4.1.2021.4.6.0",
      "type": "gauge_kb",
      "unit": "KB",
      "history": "none"
    },
    {
      "key": "wan_in_octets",
      "if_name": "eth4",
      "column": "1.3.6.1.2.1.31.1.1.1.6",
      "type": "counter64",
      "unit": "bytes",
      "history": "none"
    },
    {
      "key": "wan_out_octets",
      "if_name": "eth4",
      "column": "1.3.6.1.2.1.31.1.1.1.10",
      "type": "counter64",
      "unit": "bytes",
      "history": "none"
    },
    {
      "key": "wan_status",
      "if_name": "eth4",
      "column": "1.3.6.1.2.1.2.2.1.8",
