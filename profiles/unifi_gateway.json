{
  "profile_id": "unifi_gateway",
  "name": "UniFi Cloud Gateway (UCG Ultra / UXG)",
  "vendor": "Ubiquiti",
  "category": "gateway",
  "match_priority": 20,
  "signature_oids": [
    {
      "oid": "1.3.6.1.2.1.1.1.0",
      "match_contains": "UCG"
    },
    {
      "oid": "1.3.6.1.2.1.1.1.0",
      "match_contains": "UXG"
    }
  ],
  "tables": [
    "interfaces",
    "arp"
  ],
  "inventory_regex": {
    "model": "UniFi (\\S+)",
    "firmware": "UniFi \\S+ (\\S+)"
  },
  "metrics": [
    {
      "key": "uptime_seconds",
      "oid": "1.3.6.1.2.1.1.3.0",
